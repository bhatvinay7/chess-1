generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GameStatus {
  WAITING
  ACTIVE
  DRAW
  WHITE_WIN
  BLACK_WIN
  ABANDONED
}

enum GameResult {
  WIN
  LOSS
  DRAW
}

enum TournamentAccessType {
  CLUB
  CROSS_CLUB
  OPEN
  PRIVATE
}

enum TournamentType {
  CLUB_SWISS
  CLUB_ROUND_ROBIN

  GLOBAL_SWISS
  GLOBAL_ROUND_ROBIN

  DAILY
  ARENA
}

enum TournamentStatus {
  DRAFT
  REGISTRATION_OPEN
  REGISTRATION_CLOSED

  NOT_INITIALIZED
  IN_PROGRESS
  COMPLETED

  CANCELLED
}

enum TournamentVisibility {
  PUBLIC
  PRIVATE
  CLUB_ONLY
}

enum RoundStatus {
  NOT_INITIALIZED
  IN_PROGRESS
  COMPLETED
}

enum MatchStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  DRAW
  ABANDONED
}

enum ResultType {
  WHITE_WIN
  BLACK_WIN
  DRAW
  BYE
}

enum TournamentRole {
  PLAYER
  DIRECTOR
  ADMIN
}

enum TournamentInviteStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum Color {
  WHITE
  BLACK
}

enum ClubRole {
  ADMIN
  COORDINATOR
  MEMBER
}

enum ClubRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  REJECTED
  BLOCKED
}

enum PairingLogic {
  SCORE_BASED
  RATING_BASED
}

enum PairingEngine {
  DUTCH
  BURSTEIN
  ACCELERATED
}

enum PairingStatus {
  GENERATED
  APPROVED
  PUBLISHED
}

enum ByeType {
  FULL_POINT
  HALF_POINT
  ZERO_POINT
}

enum TieBreakMethod {
  BUCHHOLZ
  MEDIAN_BUCHHOLZ
  SONNEBORN_BERGER
  DIRECT_ENCOUNTER
  MOST_WINS
}

enum TimeControlCategory {
  BULLET
  BLITZ
  RAPID
  DAILY
}

enum RatingCategory {
  BULLET
  BLITZ
  RAPID
}

enum GameType {
  STANDARD
  CHESS960
}

enum AuthType {
  CREDENTIALS
  GOOGLE
}

model User {
  id              String   @id @default(uuid()) @db.Uuid
  username        String   @unique
  email           String?  @unique
  profileImageUrl String?
  bio             String?
  password        String?
  isAdmin         Boolean  @default(false)
  rating          Int      @default(1200)
  wins            Int      @default(0)
  losses          Int      @default(0)
  draws           Int      @default(0)
  tournamentId    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  whiteGames Game[]      @relation("WhitePlayer")
  blackGames Game[]      @relation("BlackPlayer")
  wonGames   Game[]      @relation("Winner")
  moves      Move[]
  tournament Tournament? @relation(fields: [tournamentId], references: [id], onDelete: SetNull)

  tournamentPartici TournamentParticipant[]
  tournamentState   TournamentStanding[]

  createdTournaments Tournament[]       @relation("TournamentCreator")
  receivedInvites    TournamentInvite[] @relation("InvitedPlayer")
  sentInvites        TournamentInvite[] @relation("InvitedBy")
  player             TournamentBye[]
  ratings            UserRating[]
  authMethods        UserAuth[]

  createdClubs          Club[]                  @relation("ClubCreator")
  clubMemberships       ClubMember[]
  clubJoinRequests      ClubJoinRequest[]
  sentCoordInvites      ClubCoordinatorInvite[] @relation("CoordInvitedBy")
  receivedCoordInvites  ClubCoordinatorInvite[] @relation("CoordInvited")

  sentFriendRequests     Friendship[] @relation("FriendRequester")
  receivedFriendRequests Friendship[] @relation("FriendRecipient")
}

model UserAuth {
  id           String   @id @default(cuid())
  userId       String   @db.Uuid
  authType     AuthType @default(CREDENTIALS)
  providerId   String   @unique
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, authType])
}

model UserRating {
  id       String         @id @default(cuid())
  userId   String         @db.Uuid
  category RatingCategory
  rating   Int            @default(1200)
  wins     Int            @default(0)
  losses   Int            @default(0)
  draws    Int            @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@index([userId])
}

model Puzzle {
  id          String   @id @default(uuid()) @db.Uuid
  initialFen  String
  solution    Json
  movesToMate Int
  rating      Int      @default(1200)
  createdAt   DateTime @default(now())

  games Game[]
}

model Game {
  id               String     @id @default(uuid()) @db.Uuid
  whitePlayerId    String     @db.Uuid
  blackPlayerId    String?    @db.Uuid
  winnerId         String?    @db.Uuid
  puzzleId         String?    @db.Uuid
  initialFen       String     @default("startpos")
  currentFen       String     @default("startpos")
  pgn              String     @default("")
  status           GameStatus @default(WAITING)
  timeControl      String     @default("10+0")
  gameMode         String     @default("standard")
  isRated          Boolean    @default(false)
  increment        Int        @default(0)
  whiteRating      Int?
  blackRating      Int?
  whiteRatingAfter Int?
  blackRatingAfter Int?
  whiteRatingGain  Int?
  blackRatingGain  Int?
  startedAt        DateTime?
  endedAt          DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  whitePlayer User    @relation("WhitePlayer", fields: [whitePlayerId], references: [id])
  blackPlayer User?   @relation("BlackPlayer", fields: [blackPlayerId], references: [id])
  winner      User?   @relation("Winner", fields: [winnerId], references: [id])
  puzzle      Puzzle? @relation(fields: [puzzleId], references: [id])
  moves       Move[]

  gameState    GameState?
  tournamentId String?
  tournament   Tournament? @relation(fields: [tournamentId], references: [id], onDelete: SetNull)

  analysis GameAnalysis?
  matchId  Match[]

  @@index([status])
  @@index([whitePlayerId])
  @@index([blackPlayerId])
  @@index([createdAt])
}

model GameAnalysis {
  id              String    @id @default(uuid()) @db.Uuid
  gameId          String    @unique @db.Uuid
  overall         String    @default("Review pending")
  whiteWinRate    Float     @default(50)
  blackWinRate    Float     @default(50)
  whiteAccuracy   Float?
  blackAccuracy   Float?
  averageAccuracy Float?
  reviewedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  game            Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId])
}

model GameState {
  id                  String   @id @default(uuid()) @db.Uuid
  gameId              String   @unique @db.Uuid
  whitePlayerLeftTime Int      @default(0)
  blackPlayerLeftTime Int      @default(0)
  increment           Int      @default(0)
  timeSlot            String   @default("")
  gameState           String   @default("INITIALIZED")
  gameMode            String   @default("standard")
  isRated             Boolean  @default(false)
  winnerId            String?  @db.Uuid
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  game                Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId])
}

model Move {
  id       String @id @default(uuid()) @db.Uuid
  gameId   String @db.Uuid
  playerId String @db.Uuid

  moveNumber Int

  san String

  uci String?

  fenAfter String

  fromSquare String?

  toSquare String?

  promotion String?

  timeTakenMs Int?

  createdAt DateTime @default(now())

  game   Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  player User @relation(fields: [playerId], references: [id])

  @@unique([gameId, moveNumber])
  @@index([playerId])
  @@index([gameId])
}

model TimeControl {
  id String @id @default(cuid())

  category TimeControlCategory

  initialTimeSec Int? @default(0)
  incrementSec   Int? @default(0)

  daysPerMove Int? @default(0)

  displayName String

  createdAt DateTime @default(now())

  tournaments Tournament[]
}

model Tournament {
  id String @id @default(cuid())

  name        String
  description String?

  accessType     TournamentAccessType
  tournamentType TournamentType
  visibility     TournamentVisibility

  status TournamentStatus @default(DRAFT)

  creatorId String @db.Uuid
  creator   User   @relation("TournamentCreator", fields: [creatorId], references: [id])

  clubId String?
  club   Club?   @relation(fields: [clubId], references: [id])

  gameType GameType @default(STANDARD)

  isRated Boolean @default(true)

  inviteOnly Boolean @default(false)

  premiumOnly Boolean @default(false)

  requiresApproval Boolean @default(false)

  autoStartWhenFull Boolean @default(false)

  allowVacation Boolean @default(false)

  allowLateJoin Boolean @default(false)

  useTieBreaks Boolean @default(true)

  tieBreakMethod TieBreakMethod?

  minPlayers Int?
  maxPlayers Int?

  minRating Int?
  maxRating Int?

  minGamesPlayed Int?
  
  customFen   String?
  openingName String?

  timeControlId String?
  timeControl   TimeControl? @relation(fields: [timeControlId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  participants TournamentParticipant[]
  users        User[]
  rounds       Round[]
  matches      Match[]

  standings TournamentStanding[]

  groups TournamentGroup[]

  invites TournamentInvite[]

  byes TournamentBye[]

  swissSettings    SwissSettings?
  arenaSettings    ArenaSettings?
  dailySettings    DailySettings?
  timeManagement   TournamentTimeManagement?
  pairingAudits    PairingAudit[]
  history          Game[]
  crossClubInvites CrossClubInvite[]
}

model TournamentTimeManagement {
  id                  String    @id @default(cuid())
  tournamentId        String    @unique
  registrationOpenAt  DateTime
  registrationCloseAt DateTime
  startTime           DateTime
  endTime             DateTime?

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
}



model SwissSettings {
  id String @id @default(cuid())

  tournamentId String @unique

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  totalRounds Int

  pairingEngine PairingEngine @default(DUTCH)

  preventRepeatPairs Boolean @default(true)

  balanceColors Boolean @default(true)

  avoidThreeSameColors Boolean @default(true)

  allowBye Boolean @default(true)

  createdAt DateTime @default(now())
}

model ArenaSettings {
  id String @id @default(cuid())

  tournamentId String @unique

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  durationMinutes Int

  pairingLogic PairingLogic

  berserkEnabled Boolean @default(false)

  streakBonusEnabled Boolean @default(false)

  createdAt DateTime @default(now())
}

model DailySettings {
  id String @id @default(cuid())

  tournamentId String @unique

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  groupSize Int

  advancePerGroup Int

  concurrentGamesPerOpponent Int @default(2)

  daysPerMove Int

  allowVacation Boolean @default(true)

  useTieBreaks Boolean @default(true)

  createdAt DateTime @default(now())
}

model TournamentParticipant {
  id String @id @default(cuid())

  tournamentId String
  playerId     String @db.Uuid 

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  player User @relation(fields: [playerId], references: [id])

  role TournamentRole @default(PLAYER)

  seed Int?

  ratingAtJoin Int?

  joinedAt DateTime @default(now())

  stats TournamentPlayerStats?

  @@unique([tournamentId, playerId])
}

model TournamentPlayerStats {
  id String @id @default(cuid())

  tournamentParticipantId String @unique

  participant TournamentParticipant @relation(fields: [tournamentParticipantId], references: [id])

  score Float @default(0)

  wins   Int @default(0)
  draws  Int @default(0)
  losses Int @default(0)

  currentRank Int?

  byeReceived Boolean @default(false)

  consecutiveWhite Int @default(0)
  consecutiveBlack Int @default(0)

  totalWhiteGames Int @default(0)
  totalBlackGames Int @default(0)

  buchholz Float @default(0)

  medianBuchholz Float @default(0)

  sonnebornBerger Float @default(0)

  cumulativeScore Float @default(0)

  performanceRating Float?

  directEncounterScore Float @default(0)

  updatedAt DateTime @updatedAt
}

model Round {
  id String @id @default(cuid())

  tournamentId String

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  roundNumber Int

  status RoundStatus @default(NOT_INITIALIZED)

  startTime DateTime?
  endTime   DateTime?

  groups  TournamentGroup[]
  matches Match[]

  createdAt DateTime @default(now())

  @@unique([tournamentId, roundNumber])
}

model Match {
  id           String           @id @default(cuid())
  tournamentId String
  roundId      String?
  groupId      String?
  gameId       String @db.Uuid 
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  round        Round?           @relation(fields: [roundId], references: [id])
  game         Game             @relation(fields: [gameId], references: [id])
  group        TournamentGroup? @relation(fields: [groupId], references: [id])
  scheduledAt  DateTime         @default(now())
  isProcessed  Boolean          @default(false)
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime         @default(now())
}

model TournamentStanding {
  id String @id @default(cuid())

  tournamentId String @unique
  playerId     String @unique @db.Uuid 

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  player User @relation(fields: [playerId], references: [id])

  rank Int

  score Float

  wins   Int @default(0)
  draws  Int @default(0)
  losses Int @default(0)

  buchholz Float @default(0)

  medianBuchholz Float @default(0)

  sonnebornBerger Float @default(0)

  directEncounterScore Float @default(0)

  updatedAt DateTime @updatedAt

  @@unique([tournamentId, playerId])
}

model TournamentGroup {
  id String @id @default(cuid())

  tournamentId String

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  roundNumber Int

  groupNumber Int

  createdAt DateTime @default(now())
  matches   Match[]
  rounds    Round[]

  @@unique([tournamentId, roundNumber, groupNumber])
}

model TournamentInvite {
  id String @id @default(cuid())

  tournamentId String

  invitedPlayerId String  @db.Uuid

  invitedById String @db.Uuid

  status TournamentInviteStatus @default(PENDING)

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  invitedPlayer User     @relation("InvitedPlayer", fields: [invitedPlayerId], references: [id])
  invitedBy     User     @relation("InvitedBy", fields: [invitedById], references: [id])
  createdAt     DateTime @default(now())

  @@unique([tournamentId, invitedPlayerId])
}

model TournamentBye {
  id           String @id @default(cuid())
  tournamentId String

  playerId String  @db.Uuid

  roundNumber Int

  byeType ByeType @default(FULL_POINT)

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  player User @relation(fields: [playerId], references: [id])

  createdAt DateTime @default(now())

  @@unique([tournamentId, playerId, roundNumber])
}

model PairingAudit {
  id String @id @default(cuid())

  tournamentId String

  roundNumber Int

  playerAId String @db.Uuid 

  playerBId String @db.Uuid 

  pairingScore Float

  sameScoreGroup Boolean

  colorConflict Boolean

  repeatOpponent Boolean

  status PairingStatus

  generatedBy String?

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model Club {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  imageUrl    String  @default("https://res.cloudinary.com/dhfyav4og/image/upload/v1779739162/defaultUser_afbf5y.jpg")
  creatorId   String  @db.Uuid

  creator    User                   @relation("ClubCreator", fields: [creatorId], references: [id])
  members    ClubMember[]
  joinRequests ClubJoinRequest[]
  coordinatorInvites ClubCoordinatorInvite[]
  tournaments Tournament[]
  crossClubInvites CrossClubInvite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CrossClubInvite {
  id           String            @id @default(cuid())
  tournamentId String
  clubId       String
  status       ClubRequestStatus @default(PENDING)

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  club       Club       @relation(fields: [clubId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tournamentId, clubId])
  @@index([clubId])
}

model ClubMember {
  id       String   @id @default(cuid())
  clubId   String
  userId   String   @db.Uuid
  role     ClubRole @default(MEMBER)

  club     Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  joinedAt DateTime @default(now())

  @@unique([clubId, userId])
  @@index([clubId])
  @@index([userId])
}

model ClubJoinRequest {
  id     String            @id @default(cuid())
  clubId String
  userId String            @db.Uuid
  status ClubRequestStatus @default(PENDING)

  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clubId, userId])
  @@index([clubId])
}

model ClubCoordinatorInvite {
  id            String            @id @default(cuid())
  clubId        String
  invitedUserId String            @db.Uuid
  invitedById   String            @db.Uuid
  status        ClubRequestStatus @default(PENDING)

  club        Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  invitedUser User @relation("CoordInvited", fields: [invitedUserId], references: [id])
  invitedBy   User @relation("CoordInvitedBy", fields: [invitedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clubId, invitedUserId])
  @@index([clubId])
}

model Friendship {
  id          String           @id @default(cuid())
  requesterId String           @db.Uuid
  recipientId String           @db.Uuid
  status      FriendshipStatus @default(PENDING)

  requester User @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  recipient User @relation("FriendRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([requesterId, recipientId])
  @@index([requesterId])
  @@index([recipientId])
}
