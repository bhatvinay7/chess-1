# ── FRONTEND SECRETS (Needed for Docker build & K8s Runtime) ──
NEXT_PUBLIC_API_URL=https://api.chesscounty.life/api/v1/
NEXT_PUBLIC_SOCKET_URL=https://ws.chesscounty.life
NEXT_PUBLIC_R2_PUBLIC_URL=https://assets.chesscounty.life
NEXT_PUBLIC_USE_REMOTE_STOCKFISH=false
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ── BACKEND SECRETS (Needed for K8s Runtime) ──
# Because you are using Managed Cloud Databases, paste their URLs here:
DATABASE_URL=postgres://user:pass@your-cloud-db-host:25060/defaultdb?sslmode=require
REDIS_URL=rediss://default:pass@your-cloud-redis-host:25061
MONGO_DB_URL=mongodb+srv://user:pass@your-cloud-mongo-host/chess?retryWrites=true&w=majority
RABBITMQ_URL=amqps://user:pass@your-cloud-rabbitmq-host

# Dedicated integration-test services (loaded from the root .env by Rust tests)
TEST_DATABASE_URL=postgres://test_user:test_pass@localhost:5432/chess_test
TEST_REDIS_URL=redis://localhost:6379
TEST_RABBITMQ_URL=amqp://localhost:5672/%2f

# Infrastructure & API Keys
GRPC_SERVER_URL=grpc.chesscounty.life:443
INVITATION_ENCRYPTION_KEY=super_secret_encryption_key_32_chars
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret

# Email / SMTP
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=postmaster@chesscounty.life
SMTP_PASS=your_smtp_password
SMTP_FROM=noreply@chesscounty.life

# PostgreSQL Logical Replication (for CDC)
REPLICATION_URL=postgres://user:pass@your-cloud-db-host:25060/defaultdb?sslmode=require
SLOT_NAME=chess_slot
PUBLICATION=chess_pub
